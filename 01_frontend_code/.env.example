# When true (default for local dev), module APIs return mock data.
# # When false, module APIs call the real backend via Axios.
# VITE_USE_MOCK_API=true

# # Backend base URL (used when VITE_USE_MOCK_API=false)
# VITE_API_BASE_URL=http://localhost:8000/api/v1

VITE_API_BASE_URL=http://localhost:8001/api/v1
VITE_USE_MOCK_API=false