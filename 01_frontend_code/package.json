{
  "name": "bytevon-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/shared src/config",
    "test:integration": "vitest run src/modules",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:live": "powershell -ExecutionPolicy Bypass -File ./scripts/test-live-api.ps1",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@reduxjs/toolkit": "^2.2.7",
    "@tanstack/react-query": "^5.62.8",
    "@tanstack/react-router": "^1.91.3",
    "@tanstack/react-table": "^8.20.6",
    "@tanstack/react-virtual": "^3.14.10",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-redux": "^9.1.2",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.1",
