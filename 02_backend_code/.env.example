# ByteVon CRM backend environment
# Copy to .env and adjust.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bytevon
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7
SYSTEM_EMPLOYMENT_ID=1
APP_NAME=ByteVon CRM API
APP_ENV=development
LOG_LEVEL=INFO

# ---- Email (SMTP via Gmail) ----
# Fill these in .env (never commit real values).
# Gmail setup: Google Account → Security → 2-Step Verification ON →
# App passwords → generate one for "Mail" → paste below WITHOUT spaces.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ByteVon CRM
SMTP_TIMEOUT_SECONDS=15
FRONTEND_URL=http://localhost:5173
