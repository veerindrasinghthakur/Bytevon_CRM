# ByteVon CRM — Docker environment template (development placeholders only).
# Copy to .env and adjust:  copy .env.example .env   (Windows)
#                           cp .env.example .env      (Linux/macOS)
# Never commit .env (it holds real secrets).

# Application
APP_NAME=ByteVon CRM
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# PostgreSQL (service: postgres) — used by Docker Compose only
POSTGRES_DB=bytevon
POSTGRES_USER=bytevon
POSTGRES_PASSWORD=bytevon_dev_password
POSTGRES_PORT=5432

# SQLAlchemy async URL (asyncpg). Host MUST be the compose service name in
# Docker; use the Neon pooled connection URL for Render (add ?sslmode=require).
DATABASE_URL=postgresql+asyncpg://bytevon:bytevon_dev_password@postgres:5432/bytevon
DATABASE_ECHO=false

# Connection pool (keep low for Neon free tier — max 25 connections total).
# Direct (non-pooled) Neon connections are required for Alembic migrations.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=5

# JWT — generate a secure secret before sharing or deploying.
# Run:  python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters. NEVER use the placeholder in production.
JWT_SECRET_KEY=dev-only-change-me-to-a-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30

# Backend
BACKEND_PORT=8000

# Startup mode (controls docker-entrypoint.sh behaviour):
#   app     — wait for DB then start Uvicorn only (Render default)
#   init    — migrate + seed then exit (Render one-off initialisation)
#   compose — full local flow: migrate + seed + MinIO buckets + Uvicorn
STARTUP_MODE=compose

# Port injected by Render at runtime.  Leave as 8000 for local Compose.
PORT=8000

# Frontend
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=/api/v1

# CORS (comma-separated string, matches CORS_ORIGINS setting).
# Must include the Docker frontend origin for local dev.
CORS_ORIGINS=http://localhost:3000

# Object storage (MinIO) — set STORAGE_ENABLED=true only when MinIO is running.
# For Render prototype: set STORAGE_ENABLED=false (no MinIO service available).
# For local Docker Compose: set STORAGE_ENABLED=true.
STORAGE_ENABLED=true
MINIO_ROOT_USER=bytevon_minio
MINIO_ROOT_PASSWORD=bytevon_minio_password_change_me
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=bytevon_minio
MINIO_SECRET_KEY=bytevon_minio_password_change_me
MINIO_SECURE=false

# MinIO host ports
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Email (SMTP) — disabled by default; set EMAIL_ENABLED=true to send real emails.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ByteVon CRM
