# ByteVon CRM — Docker environment template (development placeholders only).
# Copy to .env and adjust:  copy .env.example .env
# Never commit .env (it holds real secrets).

# Application
APP_NAME=ByteVon CRM
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# PostgreSQL (service: postgres)
POSTGRES_DB=bytevon
POSTGRES_USER=bytevon
POSTGRES_PASSWORD=bytevon_dev_password
POSTGRES_PORT=5432

# SQLAlchemy async URL (asyncpg). Host MUST be the compose service name.
DATABASE_URL=postgresql+asyncpg://bytevon:bytevon_dev_password@postgres:5432/bytevon
DATABASE_ECHO=false

# JWT (field names must match app/core/config.py).
# DEVELOPMENT PLACEHOLDER ONLY — generate a fresh random secret per environment.
JWT_SECRET_KEY=dev-only-change-me-to-a-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30

# Backend
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=/api/v1

# CORS (comma-separated string, matches CORS_ORIGINS setting).
# Must include the Docker frontend origin.
CORS_ORIGINS=http://localhost:3000

# MinIO (service: minio). Internal backend endpoint must be minio:9000.
MINIO_ROOT_USER=bytevon_minio
MINIO_ROOT_PASSWORD=bytevon_minio_password_change_me
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=bytevon_minio
MINIO_SECRET_KEY=bytevon_minio_password_change_me
MINIO_SECURE=false

# MinIO host ports
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Buckets actually used by the backend (audit-archives, notification-attachments,
# avatars) are ensured idempotently at backend startup. No extra config needed.
