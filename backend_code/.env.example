# ByteVon CRM backend environment
# Copy to .env and adjust.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bytevon
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=10
JWT_REFRESH_TTL_DAYS=7
SYSTEM_EMPLOYMENT_ID=1
APP_NAME=ByteVon CRM API
APP_ENV=development
LOG_LEVEL=INFO
