# Application
APP_NAME=ByteVon CRM
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://bytevon:bytevon@localhost:5432/bytevon_crm
DATABASE_ECHO=false

# JWT / Auth (Auth V1)
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Password reset tokens
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=10

# Account lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# System actor (reserved employment id for system actions)
SYSTEM_EMPLOYMENT_ID=1

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
